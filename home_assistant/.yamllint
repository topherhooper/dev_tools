extends: default

ignore: |
  .venv/
  # UI-managed: Home Assistant rewrites these, so their formatting is not ours to police.
  config/automations.yaml
  config/scripts.yaml
  config/scenes.yaml

rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
