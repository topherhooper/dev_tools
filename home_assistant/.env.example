# Copy to .env (git-ignored) and fill in. hactl reads this automatically.
# Long-lived token: HA profile page -> Security -> Long-lived access tokens.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# SSH target for deploy/pull (needs rsync on both ends; HA OS: use the
# "Advanced SSH & Web Terminal" add-on with rsync installed).
HA_SSH=root@homeassistant.local
HA_CONFIG_DIR=/config
